# ==================== Docker Compose top-level env ====================

# PostgreSQL
POSTGRES_USER=ash
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=ash_holding

# Backend – JWT & cookies
JWT_SECRET=replace-me-with-a-64-char-random-string
JWT_REFRESH_SECRET=replace-me-with-another-64-char-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
COOKIE_SECRET=replace-me-with-cookie-signing-secret

# Uploads
UPLOAD_MAX_MB=25
UPLOAD_ALLOWED_MIME=image/png,image/jpeg,image/webp,application/pdf,application/zip

# CORS – set to your domain(s)
CORS_ORIGIN=http://localhost

# Frontend
VITE_API_URL=/api

# Seed accounts (development only – change and re-run seed for production)
SEED_ADMIN_EMAIL=admin@ashholding.sa
SEED_ADMIN_PASSWORD=Admin@12345
SEED_CLIENT_EMAIL=client@demo.sa
SEED_CLIENT_PASSWORD=Client@12345
