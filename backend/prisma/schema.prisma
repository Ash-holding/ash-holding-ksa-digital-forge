// Prisma schema for ASH HOLDING backend
// Database: PostgreSQL (self-hosted VPS)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== ENUMS =====================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT
  ACCOUNTANT
  AFFILIATE_MANAGER
  AFFILIATE
  FINANCE_REVIEWER
  CREDIT_ANALYST
  CREDIT_MANAGER
  RISK_OFFICER
  COMPLIANCE_OFFICER
  LEGAL_OFFICER
  COLLECTIONS_OFFICER
  CFO
  CREDIT_COMMITTEE
  FINAL_APPROVER
  INTERNAL_AUDITOR
  CLIENT
}

enum UserStatus {
  ACTIVE
  DISABLED
  PENDING
}

enum ClientStatus {
  ACTIVE
  DISABLED
  PENDING
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}


enum ProjectStatus {
  NEW
  PLANNING
  DESIGN
  DEVELOPMENT
  WAITING_CLIENT
  TESTING
  COMPLETED
  ON_HOLD
}

enum ProjectRequestStatus {
  PENDING
  UNDER_REVIEW
  PROPOSAL_SENT
  CLIENT_REVISION
  AWAITING_SIGNATURE
  SIGNED
  IN_PROGRESS
  DELIVERED
  APPROVED
  REJECTED
  CONVERTED
  COMPLETED
}

enum ProjectRequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NoteVisibility {
  INTERNAL
  CLIENT
}

enum ServiceType {
  WEBSITE
  MOBILE_APP
  ADMIN_SYSTEM
  HOSTING
  VPS
  DEDICATED_SERVER
  SMTP
  MARKETING
  DESIGN
  SUPPORT
  OTHER
}

enum ServiceStatus {
  ACTIVE
  SUSPENDED
  AWAITING_PAYMENT
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PAID
  OVERDUE
  CANCELLED
}

enum ContractStatus {
  DRAFT
  SENT
  PENDING_SIGNATURE
  SIGNED
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CLIENT
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  BANK_TRANSFER
  PAYLINK
  CASH
  MANUAL
  WALLET
  ELECTRONIC
}

enum WalletTxType {
  TOPUP
  WITHDRAW
  PAYMENT
  REFUND
  CASHBACK
  ADJUSTMENT
  FINANCING_DISBURSE
  FINANCING_INSTALLMENT
}

enum WalletTxStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  INFO
  INVOICE
  CONTRACT
  TICKET
  PROJECT
  PAYMENT
}

// ===================== MODELS =====================

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  phone        String?
  role         UserRole   @default(CLIENT)
  status       UserStatus @default(ACTIVE)
  avatarUrl    String?
  lastLoginAt  DateTime?
  lastIpAddress String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  client          Client?
  refreshTokens   RefreshToken[]
  assignedTickets SupportTicket[] @relation("AssignedAgent")
  ticketMessages  TicketMessage[]
  uploadedFiles   File[]          @relation("UploadedBy")
  notifications   Notification[]
  auditLogs       AuditLog[]
  projectNotes    ProjectNote[]
  projectMessages ProjectMessage[]
  verifiedClients Client[]        @relation("VerifiedBy")
  affiliate       Affiliate?


  @@index([role])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Client {
  id               String       @id @default(cuid())
  userId           String       @unique
  companyName      String?
  commercialNumber String?
  taxNumber        String?
  phone            String?
  contactEmail     String?
  address          String?
  city             String?
  country          String       @default("SA")
  status           ClientStatus @default(ACTIVE)

  // Verification
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedAt         DateTime?
  verifiedById       String?
  verificationNote   String?

  // Geolocation / IP tracking
  lastIpAddress String?
  lastIpCountry String?
  lastIpCity    String?
  lastIpRegion  String?
  lat           Decimal? @db.Decimal(9, 6)
  lng           Decimal? @db.Decimal(9, 6)
  lastSeenAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy User?           @relation("VerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  projects   Project[]
  services   ClientService[]
  invoices   Invoice[]
  contracts  Contract[]
  tickets    SupportTicket[]
  payments   Payment[]
  files      File[]
  projectRequests ProjectRequest[]
  wallet     Wallet?

  @@index([status])
  @@index([verificationStatus])
}

model Wallet {
  id               String   @id @default(cuid())
  clientId         String   @unique
  balance          Decimal  @default(0) @db.Decimal(14, 2)
  cashbackBalance  Decimal  @default(0) @db.Decimal(14, 2)
  currency         String   @default("SAR")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  client       Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id            String         @id @default(cuid())
  walletId      String
  type          WalletTxType
  status        WalletTxStatus @default(PENDING)
  amount        Decimal        @db.Decimal(14, 2)
  balanceAfter  Decimal?       @db.Decimal(14, 2)
  currency      String         @default("SAR")
  reference     String?
  invoiceId     String?
  paymentId     String?
  bankRef       String?
  iban          String?
  note          String?
  receiptUrl    String?
  createdById   String?
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime       @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}


model Project {
  id          String        @id @default(cuid())
  clientId    String
  title       String
  description String?
  status      ProjectStatus @default(NEW)
  progress    Int           @default(0)
  budget      Decimal?      @db.Decimal(12, 2)
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  client    Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoices  Invoice[]
  contracts Contract[]
  services  ClientService[]
  files     File[]
  notes     ProjectNote[]
  stages    ProjectStage[]
  messages  ProjectMessage[]

  @@index([clientId])
  @@index([status])
}

model ProjectNote {
  id         String         @id @default(cuid())
  projectId  String
  authorId   String
  content    String
  visibility NoteVisibility @default(INTERNAL)
  createdAt  DateTime       @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([projectId])
}

enum ProjectStageStatus {
  PENDING
  IN_PROGRESS
  BLOCKED
  DONE
  SKIPPED
}

model ProjectStage {
  id          String             @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      ProjectStageStatus @default(PENDING)
  progress    Int                @default(0)
  weight      Int                @default(1)
  orderIndex  Int                @default(0)
  dueDate     DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}

model ProjectMessage {
  id           String   @id @default(cuid())
  projectId    String
  authorId     String
  content      String
  attachments  Json?
  isInternal   Boolean  @default(false)
  readByClient Boolean  @default(false)
  readByStaff  Boolean  @default(false)
  createdAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([projectId])
  @@index([createdAt])
}

model ClientService {
  id          String        @id @default(cuid())
  clientId    String
  projectId   String?
  name        String
  type        ServiceType   @default(OTHER)
  status      ServiceStatus @default(ACTIVE)
  price       Decimal?      @db.Decimal(12, 2)
  currency    String        @default("SAR")
  renewalDate DateTime?
  startedAt   DateTime      @default(now())
  endedAt     DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id])

  @@index([clientId])
  @@index([status])
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  clientId      String
  projectId     String?
  status        InvoiceStatus @default(DRAFT)
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  taxRate       Decimal       @default(15) @db.Decimal(5, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  currency      String        @default("SAR")
  issuedAt      DateTime      @default(now())
  dueAt         DateTime?
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  client   Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project  Project?      @relation(fields: [projectId], references: [id])
  items    InvoiceItem[]
  payments Payment[]
  requests ProjectRequest[] @relation("RequestInvoice")

  @@index([clientId])
  @@index([status])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  title       String
  description String?
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Contract {
  id             String         @id @default(cuid())
  contractNumber String         @unique
  clientId       String
  projectId      String?
  title          String
  status         ContractStatus @default(DRAFT)
  value          Decimal?       @db.Decimal(12, 2)
  currency       String         @default("SAR")
  startDate      DateTime?
  endDate        DateTime?
  filePath       String?
  signedFilePath String?
  signedAt       DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id])
  files   File[]

  @@index([clientId])
  @@index([status])
}

model SupportTicket {
  id           String         @id @default(cuid())
  ticketNumber String         @unique
  clientId     String
  subject      String
  description  String?
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(NORMAL)
  assignedToId String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  closedAt     DateTime?

  client   Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agent    User?           @relation("AssignedAgent", fields: [assignedToId], references: [id])
  messages TicketMessage[]
  files    File[]

  @@index([clientId])
  @@index([status])
  @@index([priority])
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  senderId   String
  message    String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id])

  @@index([ticketId])
}

model Payment {
  id             String        @id @default(cuid())
  clientId       String
  invoiceId      String?
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("SAR")
  method         PaymentMethod @default(BANK_TRANSFER)
  transactionRef String?
  status         PaymentStatus @default(PENDING)
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime      @default(now())

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([clientId])
  @@index([status])
}

model File {
  id           String   @id @default(cuid())
  clientId     String?
  projectId    String?
  ticketId     String?
  contractId   String?
  uploadedById String
  originalName String
  storedName   String
  path         String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())

  client   Client?        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project  Project?       @relation(fields: [projectId], references: [id])
  ticket   SupportTicket? @relation(fields: [ticketId], references: [id])
  contract Contract?      @relation(fields: [contractId], references: [id])
  uploader User           @relation("UploadedBy", fields: [uploadedById], references: [id])

  @@index([clientId])
  @@index([projectId])
  @@index([ticketId])
  @@index([contractId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  body      String?
  link      String?
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model ProjectRequest {
  id           String                 @id @default(cuid())
  clientId     String
  title        String
  description  String?
  category     ServiceType            @default(OTHER)
  priority     ProjectRequestPriority @default(NORMAL)
  budgetMin    Decimal?               @db.Decimal(12, 2)
  budgetMax    Decimal?               @db.Decimal(12, 2)
  targetDate   DateTime?
  attachments  Json?
  contactName  String?
  contactPhone String?
  status       ProjectRequestStatus   @default(PENDING)
  adminNote    String?
  projectId    String?

  // ---- Proposal (admin → client) ----
  proposalAmount     Decimal?  @db.Decimal(12, 2)
  proposalScope      String?
  proposalDuration   Int?
  proposalValidUntil DateTime?
  proposalSentAt     DateTime?
  revisionCount      Int       @default(0)
  revisionRequest    String?

  // ---- Digital signature (client) ----
  signedAt           DateTime?
  signatureHash      String?
  signatureIp        String?
  signatureUserAgent String?

  // ---- Invoice & execution ----
  linkedInvoiceId    String?
  linkedInvoice      Invoice?  @relation("RequestInvoice", fields: [linkedInvoiceId], references: [id])
  executionStartAt   DateTime?
  executionDueAt     DateTime?

  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([status])
  @@index([createdAt])
  @@index([linkedInvoiceId])
}

// ===================== AFFILIATE / REFERRAL SYSTEM =====================

enum AffiliateStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
  CLOSED
}

enum AffiliateType {
  INDIVIDUAL
  COMPANY
}

enum AffiliateApplicationStatus {
  NEW
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum CommissionStatus {
  PENDING
  AVAILABLE
  WITHDRAWAL_REQUESTED
  PAID
  REVERSED
  REJECTED
}

enum CommissionRuleScope {
  GLOBAL
  SERVICE_TYPE
  SERVICE
  AFFILIATE
  AFFILIATE_CAMPAIGN
}

enum CommissionValueType {
  PERCENTAGE
  FIXED
  TIERED
}

enum LedgerEntryType {
  COMMISSION_PENDING
  COMMISSION_AVAILABLE
  COMMISSION_REVERSED
  COMMISSION_REJECTED
  WITHDRAWAL_HOLD
  WITHDRAWAL_PAID
  WITHDRAWAL_RELEASED
  BONUS
  ADJUSTMENT
}

enum LedgerBalanceBucket {
  PENDING
  AVAILABLE
  RESERVED
  PAID
}

enum PayoutMethodType {
  BANK_SA
  IBAN
  DIGITAL_WALLET
  ACCOUNT_CREDIT
  MANUAL
}

enum WithdrawalStatus {
  NEW
  UNDER_REVIEW
  APPROVED
  PROCESSING
  PAID
  REJECTED
  CANCELLED
}

enum AttributionModel {
  LAST_CLICK
  FIRST_CLICK
}

enum MarketingMaterialType {
  TEXT
  WHATSAPP
  SOCIAL
  EMAIL
  LANDING_LINK
  PROFILE
  OFFER
  LOGO
  GUIDE
}

model Affiliate {
  id              String          @id @default(cuid())
  userId          String          @unique
  code            String          @unique
  type            AffiliateType   @default(INDIVIDUAL)
  status          AffiliateStatus @default(PENDING)
  displayName     String
  legalName       String?
  phone           String
  email           String
  city            String?
  country         String          @default("SA")
  idNumber        String?
  commercialNo    String?
  taxNumber       String?
  bio             String?
  website         String?
  socialLinks     Json?
  preferredPayout PayoutMethodType?
  customRate      Decimal?         @db.Decimal(5, 2)
  cookieDays      Int?
  holdDays        Int?
  approvedAt      DateTime?
  approvedById    String?
  suspendedAt     DateTime?
  suspendReason   String?
  meta            Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  application     AffiliateApplication?
  campaigns       AffiliateCampaign[]
  links           AffiliateLink[]
  clicks          AffiliateClick[]
  attributions    AffiliateAttribution[]
  referredCustomers AffiliateCustomer[]
  commissions     Commission[]
  ledgerEntries   AffiliateLedgerEntry[]
  payoutAccounts  AffiliatePayoutAccount[]
  withdrawals    WithdrawalRequest[]
  notifications  AffiliateNotification[]
  rules          CommissionRule[]           @relation("AffiliateRules")
  auditLogs      AffiliateAuditLog[]

  @@index([status])
  @@index([code])
}

model AffiliateApplication {
  id            String                    @id @default(cuid())
  userId        String?
  affiliateId   String?                   @unique
  fullName      String
  phone         String
  email         String
  city          String?
  country       String                    @default("SA")
  type          AffiliateType             @default(INDIVIDUAL)
  idNumber      String?
  commercialNo  String?
  preferredPayout PayoutMethodType?
  documents     Json?
  agreementAccepted Boolean               @default(false)
  agreementVersion  String?
  notes         String?
  status        AffiliateApplicationStatus @default(NEW)
  reviewNote    String?
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  affiliate Affiliate? @relation(fields: [affiliateId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([email])
  @@index([phone])
}

model AffiliateCampaign {
  id           String    @id @default(cuid())
  affiliateId  String
  name         String
  slug         String
  description  String?
  landingPath  String    @default("/")
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  affiliate Affiliate       @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  links     AffiliateLink[]
  rules     CommissionRule[] @relation("CampaignRules")
  clicks    AffiliateClick[]

  @@unique([affiliateId, slug])
  @@index([affiliateId])
}

model AffiliateLink {
  id           String   @id @default(cuid())
  affiliateId  String
  campaignId   String?
  slug         String   @unique
  landingPath  String   @default("/")
  serviceRef   String?
  label        String?
  totalClicks  Int      @default(0)
  totalConversions Int  @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  affiliate Affiliate         @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  campaign  AffiliateCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  clicks    AffiliateClick[]

  @@index([affiliateId])
  @@index([campaignId])
}

model AffiliateClick {
  id            String   @id @default(cuid())
  affiliateId   String
  linkId        String?
  campaignId    String?
  sessionId     String
  ipHash        String?
  country       String?
  city          String?
  device        String?
  browser       String?
  os            String?
  referrer      String?
  landingPath   String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmContent    String?
  fingerprint   String?
  isBot         Boolean  @default(false)
  isUnique      Boolean  @default(true)
  createdAt     DateTime @default(now())

  affiliate Affiliate          @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  link      AffiliateLink?     @relation(fields: [linkId], references: [id], onDelete: SetNull)
  campaign  AffiliateCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([affiliateId])
  @@index([sessionId])
  @@index([createdAt])
  @@index([fingerprint])
}

model AffiliateAttribution {
  id           String   @id @default(cuid())
  affiliateId  String
  sessionId    String
  clientId     String?
  linkId       String?
  campaignId   String?
  model        AttributionModel @default(LAST_CLICK)
  firstClickAt DateTime
  lastClickAt  DateTime
  convertedAt  DateTime?
  expiresAt    DateTime
  meta         Json?

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@unique([sessionId, affiliateId])
  @@index([clientId])
  @@index([expiresAt])
}

model AffiliateCustomer {
  id            String   @id @default(cuid())
  affiliateId   String
  clientId      String   @unique
  firstOrderAt  DateTime?
  totalOrders   Int      @default(0)
  totalRevenue  Decimal  @default(0) @db.Decimal(14, 2)
  totalCommission Decimal @default(0) @db.Decimal(14, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
}

model CommissionRule {
  id            String              @id @default(cuid())
  name          String
  scope         CommissionRuleScope
  valueType     CommissionValueType @default(PERCENTAGE)
  percentage    Decimal?            @db.Decimal(5, 2)
  fixedAmount   Decimal?            @db.Decimal(12, 2)
  tiers         Json?
  serviceType   ServiceType?
  serviceRef    String?
  affiliateId   String?
  campaignId    String?
  priority      Int                 @default(0)
  maxCommission Decimal?            @db.Decimal(12, 2)
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean             @default(true)
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  affiliate Affiliate?         @relation("AffiliateRules", fields: [affiliateId], references: [id], onDelete: Cascade)
  campaign  AffiliateCampaign? @relation("CampaignRules", fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([scope, isActive])
  @@index([affiliateId])
  @@index([campaignId])
}

model Commission {
  id              String           @id @default(cuid())
  affiliateId     String
  invoiceId       String?
  paymentId       String?
  clientId        String?
  orderRef        String?
  ruleId          String?
  ruleSnapshot    Json
  baseAmount      Decimal          @db.Decimal(14, 2)
  percentage      Decimal?         @db.Decimal(5, 2)
  amount          Decimal          @db.Decimal(14, 2)
  currency        String           @default("SAR")
  status          CommissionStatus @default(PENDING)
  holdUntil       DateTime?
  availableAt     DateTime?
  paidAt          DateTime?
  reversedAt      DateTime?
  reverseReason   String?
  idempotencyKey  String           @unique
  meta            Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId, status])
  @@index([invoiceId])
  @@index([availableAt])
}

model AffiliateLedgerEntry {
  id             String              @id @default(cuid())
  affiliateId    String
  entryType      LedgerEntryType
  bucket         LedgerBalanceBucket
  amount         Decimal             @db.Decimal(14, 2)
  currency       String              @default("SAR")
  commissionId   String?
  withdrawalId   String?
  reference      String?
  note           String?
  balanceBefore  Decimal             @db.Decimal(14, 2)
  balanceAfter   Decimal             @db.Decimal(14, 2)
  createdById    String?
  createdAt      DateTime            @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId, bucket])
  @@index([commissionId])
  @@index([withdrawalId])
  @@index([createdAt])
}

model PayoutMethod {
  id          String            @id @default(cuid())
  key         String            @unique
  type        PayoutMethodType
  name        String
  description String?
  isActive    Boolean           @default(true)
  minAmount   Decimal?          @db.Decimal(12, 2)
  fee         Decimal?          @db.Decimal(12, 2)
  feePercent  Decimal?          @db.Decimal(5, 2)
  meta        Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  accounts AffiliatePayoutAccount[]
}

model AffiliatePayoutAccount {
  id             String   @id @default(cuid())
  affiliateId    String
  methodId       String
  beneficiaryName String
  bankName       String?
  ibanEncrypted  String?
  ibanMasked     String?
  accountNumber  String?
  proofFilePath  String?
  isDefault      Boolean  @default(false)
  isVerified     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  affiliate Affiliate    @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  method    PayoutMethod @relation(fields: [methodId], references: [id])
  withdrawals WithdrawalRequest[]

  @@index([affiliateId])
}

model WithdrawalRequest {
  id              String           @id @default(cuid())
  affiliateId     String
  accountId       String?
  requestNumber   String           @unique
  amount          Decimal          @db.Decimal(14, 2)
  fee             Decimal          @default(0) @db.Decimal(12, 2)
  netAmount       Decimal          @db.Decimal(14, 2)
  currency        String           @default("SAR")
  status          WithdrawalStatus @default(NEW)
  note            String?
  adminNote       String?
  reviewedById    String?
  reviewedAt      DateTime?
  transferRef     String?
  receiptPath     String?
  paidAt          DateTime?
  rejectionReason String?
  otpVerified     Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  affiliate Affiliate               @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  account   AffiliatePayoutAccount? @relation(fields: [accountId], references: [id])

  @@index([affiliateId, status])
  @@index([status])
  @@index([createdAt])
}

model MarketingMaterial {
  id          String                @id @default(cuid())
  title       String
  type        MarketingMaterialType
  category    String?
  content     String
  filePath    String?
  tags        String[]              @default([])
  isActive    Boolean               @default(true)
  createdById String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([type, isActive])
  @@index([category])
}

model AffiliateNotification {
  id          String   @id @default(cuid())
  affiliateId String
  title       String
  body        String?
  link        String?
  category    String   @default("info")
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId, isRead])
}

model AffiliateAuditLog {
  id          String   @id @default(cuid())
  affiliateId String?
  actorId     String?
  action      String
  entityType  String?
  entityId    String?
  oldValue    Json?
  newValue    Json?
  reason      String?
  ipHash      String?
  userAgent   String?
  createdAt   DateTime @default(now())

  affiliate Affiliate? @relation(fields: [affiliateId], references: [id], onDelete: SetNull)

  @@index([affiliateId])
  @@index([action])
  @@index([createdAt])
}

// ===================== FINANCING (Phase 1) =====================
// «تمويل خدمات ASH» — Closed-Loop Service Credit
// Not a bank / not a cash wallet / not a public payment instrument.
// The credit created downstream is redeemable ONLY for ASH services.

enum FinancingCustomerType {
  INDIVIDUAL
  BUSINESS
}

enum FinancingProductStatus {
  DRAFT
  PENDING_LEGAL
  APPROVED
  PUBLISHED
  PAUSED
  ARCHIVED
}

enum FinancingComplianceItemStatus {
  MISSING
  UPLOADED
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum FinancingRateBasis {
  FLAT_ANNUAL
  REDUCING_ANNUAL
  FIXED_TOTAL
}

model FinancingProduct {
  id                  String                 @id @default(cuid())
  code                String                 @unique
  nameAr              String
  descriptionAr       String?
  customerType        FinancingCustomerType
  minAmount           Decimal                @db.Decimal(14, 2)
  maxAmount           Decimal                @db.Decimal(14, 2)
  minDownPaymentPct   Decimal                @default(0)   @db.Decimal(5, 2)
  minTermMonths       Int
  maxTermMonths       Int
  allowedTermsMonths  Int[]                  @default([])
  rateBasis           FinancingRateBasis     @default(REDUCING_ANNUAL)
  ratePct             Decimal                @default(0)   @db.Decimal(6, 3)  // annual %
  adminFeePct         Decimal                @default(0)   @db.Decimal(5, 2)
  adminFeeFlat        Decimal                @default(0)   @db.Decimal(12, 2)
  vatOnFees           Boolean                @default(true)
  gracePeriodDays     Int                    @default(0)
  earlySettlementNote String?
  latePaymentNote     String?
  eligibilityNoteAr   String?
  requiredDocsAr      String[]               @default([])
  status              FinancingProductStatus @default(DRAFT)
  policyVersion       Int                    @default(1)
  startsAt            DateTime?
  endsAt              DateTime?
  createdById         String?
  approvedById        String?
  approvedAt          DateTime?
  publishedAt         DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  services            FinancingProductService[]
  applications        FinancingApplication[]
  contracts           FinancingContract[]

  @@index([status])
  @@index([customerType, status])
}

model FinancingProductService {
  id         String           @id @default(cuid())
  productId  String
  serviceId  String?          // optional link to Service model when present
  labelAr    String
  createdAt  DateTime         @default(now())

  product    FinancingProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, labelAr])
  @@index([serviceId])
}

// Global compliance / production gate — single row (key = "default")
model FinancingSetting {
  id                   String   @id @default("default")
  productionEnabled    Boolean  @default(false)
  sandboxNoticeAr      String   @default("بيئة تجريبية — الاعتماد النهائي وتفعيل الرصيد متوقفان حتى استكمال الاعتمادات القانونية.")
  minAmount            Decimal  @default(5000)    @db.Decimal(14, 2)
  maxAmount            Decimal  @default(500000)  @db.Decimal(14, 2)
  legalOpinionRef      String?
  legalCounselName     String?
  legalOpinionDate     DateTime?
  lastReviewedById     String?
  lastReviewedAt       DateTime?
  publicContactEmail   String?
  complaintsEmail      String?
  reminderDaysBefore   Int      @default(3)
  gracePeriodDays      Int      @default(3)
  latePenaltyPct       Decimal  @default(1.0) @db.Decimal(6,3)
  latePenaltyCapPct    Decimal  @default(5.0) @db.Decimal(6,3)
  autopayDefaultOn     Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model ComplianceApproval {
  id            String                        @id @default(cuid())
  code          String                        @unique   // e.g. "legal_opinion","credit_policy"
  titleAr       String
  descriptionAr String?
  status        FinancingComplianceItemStatus @default(MISSING)
  documentPath  String?
  documentHash  String?
  version       Int                           @default(1)
  approvedById  String?
  approvedAt    DateTime?
  expiresAt     DateTime?
  notes         String?
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt

  @@index([status])
}

// Independent, append-only audit trail for the financing subsystem.
// DB triggers/application code MUST NOT UPDATE or DELETE rows here.
model FinancingAuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorRole  String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// ============================================================
// Phase 3 — Financing Application Lifecycle (human review)
// ============================================================

enum FinancingApplicationStatus {
  DRAFT
  SUBMITTED
  KYC_REVIEW
  KYC_APPROVED
  KYC_REJECTED
  CREDIT_REVIEW
  RISK_REVIEW
  COMMITTEE_REVIEW
  PENDING_FINAL
  MORE_INFO
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum FinancingDecisionStage {
  KYC
  CREDIT
  RISK
  COMMITTEE
  FINAL
}

enum FinancingDecisionOutcome {
  APPROVE
  REJECT
  REQUEST_INFO
  ESCALATE
}

model FinancingApplication {
  id                 String                     @id @default(cuid())
  code               String                     @unique
  applicantId        String
  clientId           String?
  productId          String
  status             FinancingApplicationStatus @default(DRAFT)
  amount             Decimal                    @db.Decimal(14, 2)
  downPayment        Decimal                    @default(0) @db.Decimal(14, 2)
  termMonths         Int
  purposeAr          String?
  serviceLabel       String?

  // Applicant profile (INDIVIDUAL)
  fullNameAr         String?
  nationalId         String?
  birthDate          DateTime?
  employer           String?
  jobTitle           String?
  employmentType     String?
  yearsOfService     Int?
  monthlyIncome      Decimal?                   @db.Decimal(12, 2)
  monthlyObligations Decimal?                   @db.Decimal(12, 2)

  // Business (BUSINESS)
  businessName       String?
  crNumber           String?
  vatNumber          String?
  annualRevenue      Decimal?                   @db.Decimal(14, 2)

  // Consents
  consentTerms       Boolean                    @default(false)
  consentDataUse     Boolean                    @default(false)
  consentCreditCheck Boolean                    @default(false)

  // Decision
  computedScore      Int?
  quoteSnapshot      Json?
  finalApprovedById  String?
  finalApprovedAt    DateTime?
  rejectionReasonAr  String?
  submittedAt        DateTime?
  expiresAt          DateTime?

  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  product            FinancingProduct           @relation(fields: [productId], references: [id])
  documents          FinancingApplicationDocument[]
  events             FinancingApplicationEvent[]
  decisions          FinancingApplicationDecision[]
  contract           FinancingContract?

  @@index([status])
  @@index([applicantId])
  @@index([clientId])
  @@index([productId])
}

model FinancingApplicationDocument {
  id            String                        @id @default(cuid())
  applicationId String
  code          String
  labelAr       String
  filePath      String
  fileMime      String?
  fileSize      Int?
  uploadedById  String
  status        FinancingComplianceItemStatus @default(UPLOADED)
  reviewedById  String?
  reviewedAt    DateTime?
  notes         String?
  createdAt     DateTime                      @default(now())

  application   FinancingApplication          @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model FinancingApplicationEvent {
  id            String                       @id @default(cuid())
  applicationId String
  actorId       String?
  actorRole     String?
  type          String
  fromStatus    FinancingApplicationStatus?
  toStatus      FinancingApplicationStatus?
  message       String?
  metadata      Json?
  createdAt     DateTime                     @default(now())

  application   FinancingApplication         @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model FinancingApplicationDecision {
  id            String                       @id @default(cuid())
  applicationId String
  stage         FinancingDecisionStage
  outcome       FinancingDecisionOutcome
  reviewerId    String
  reviewerRole  String?
  score         Int?
  notesAr       String?
  createdAt     DateTime                     @default(now())

  application   FinancingApplication         @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

// ===================== FINANCING CONTRACT (Phase 4) =====================

enum FinancingContractStatus {
  DRAFT
  AWAITING_CLIENT_SIGNATURE
  SIGNED
  ACTIVE
  COMPLETED
  DEFAULTED
  CANCELLED
}

enum FinancingInstallmentStatus {
  PENDING
  PAID
  OVERDUE
  WAIVED
}

model FinancingContract {
  id                  String                     @id @default(cuid())
  code                String                     @unique
  applicationId       String                     @unique
  clientId            String?
  applicantId         String
  productId           String
  status              FinancingContractStatus    @default(DRAFT)

  amount              Decimal                    @db.Decimal(14, 2)
  downPayment         Decimal                    @default(0) @db.Decimal(14, 2)
  financedAmount      Decimal                    @db.Decimal(14, 2)
  termMonths          Int
  rateBasis           FinancingRateBasis
  ratePct             Decimal                    @db.Decimal(6, 3)
  installmentAmount   Decimal                    @db.Decimal(14, 2)
  totalInterest       Decimal                    @default(0) @db.Decimal(14, 2)
  totalFees           Decimal                    @default(0) @db.Decimal(14, 2)
  totalVat            Decimal                    @default(0) @db.Decimal(14, 2)
  totalPayable        Decimal                    @db.Decimal(14, 2)
  aprPct              Decimal                    @default(0) @db.Decimal(6, 3)

  firstDueDate        DateTime?
  lastDueDate         DateTime?
  scheduleSnapshot    Json?
  termsSnapshot       Json?

  clientSignedAt      DateTime?
  clientSignatureIp   String?
  clientSignatureHash String?
  clientSignatureName String?
  activatedAt         DateTime?
  activatedById       String?
  disbursedTxId       String?
  cancelledAt         DateTime?
  cancelReasonAr      String?

  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  application         FinancingApplication       @relation(fields: [applicationId], references: [id])
  product             FinancingProduct           @relation(fields: [productId], references: [id])
  installments        FinancingInstallment[]

  @@index([clientId])
  @@index([applicantId])
  @@index([status])
}

model FinancingInstallment {
  id           String                     @id @default(cuid())
  contractId   String
  n            Int
  dueDate      DateTime
  principal    Decimal                    @db.Decimal(14, 2)
  interest     Decimal                    @default(0) @db.Decimal(14, 2)
  fees         Decimal                    @default(0) @db.Decimal(14, 2)
  total        Decimal                    @db.Decimal(14, 2)
  balanceAfter Decimal                    @db.Decimal(14, 2)
  status       FinancingInstallmentStatus @default(PENDING)
  paidAt       DateTime?
  paidAmount   Decimal?                   @db.Decimal(14, 2)
  paidTxId     String?
  note         String?
  createdAt    DateTime                   @default(now())

  contract     FinancingContract          @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, n])
  @@index([status])
  @@index([dueDate])
}
