// Prisma schema for ASH HOLDING backend
// Database: PostgreSQL (self-hosted VPS)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== ENUMS =====================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT
  ACCOUNTANT
  CLIENT
}

enum UserStatus {
  ACTIVE
  DISABLED
  PENDING
}

enum ClientStatus {
  ACTIVE
  DISABLED
  PENDING
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}


enum ProjectStatus {
  NEW
  PLANNING
  DESIGN
  DEVELOPMENT
  WAITING_CLIENT
  TESTING
  COMPLETED
  ON_HOLD
}

enum ProjectRequestStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  CONVERTED
}

enum ProjectRequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NoteVisibility {
  INTERNAL
  CLIENT
}

enum ServiceType {
  WEBSITE
  MOBILE_APP
  ADMIN_SYSTEM
  HOSTING
  VPS
  DEDICATED_SERVER
  SMTP
  MARKETING
  DESIGN
  SUPPORT
  OTHER
}

enum ServiceStatus {
  ACTIVE
  SUSPENDED
  AWAITING_PAYMENT
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PAID
  OVERDUE
  CANCELLED
}

enum ContractStatus {
  DRAFT
  SENT
  PENDING_SIGNATURE
  SIGNED
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CLIENT
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  BANK_TRANSFER
  PAYLINK
  CASH
  MANUAL
}

enum NotificationType {
  INFO
  INVOICE
  CONTRACT
  TICKET
  PROJECT
  PAYMENT
}

// ===================== MODELS =====================

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  phone        String?
  role         UserRole   @default(CLIENT)
  status       UserStatus @default(ACTIVE)
  avatarUrl    String?
  lastLoginAt  DateTime?
  lastIpAddress String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  client          Client?
  refreshTokens   RefreshToken[]
  assignedTickets SupportTicket[] @relation("AssignedAgent")
  ticketMessages  TicketMessage[]
  uploadedFiles   File[]          @relation("UploadedBy")
  notifications   Notification[]
  auditLogs       AuditLog[]
  projectNotes    ProjectNote[]
  projectMessages ProjectMessage[]
  verifiedClients Client[]        @relation("VerifiedBy")


  @@index([role])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Client {
  id               String       @id @default(cuid())
  userId           String       @unique
  companyName      String?
  commercialNumber String?
  taxNumber        String?
  phone            String?
  contactEmail     String?
  address          String?
  city             String?
  country          String       @default("SA")
  status           ClientStatus @default(ACTIVE)

  // Verification
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedAt         DateTime?
  verifiedById       String?
  verificationNote   String?

  // Geolocation / IP tracking
  lastIpAddress String?
  lastIpCountry String?
  lastIpCity    String?
  lastIpRegion  String?
  lat           Decimal? @db.Decimal(9, 6)
  lng           Decimal? @db.Decimal(9, 6)
  lastSeenAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy User?           @relation("VerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  projects   Project[]
  services   ClientService[]
  invoices   Invoice[]
  contracts  Contract[]
  tickets    SupportTicket[]
  payments   Payment[]
  files      File[]
  projectRequests ProjectRequest[]

  @@index([status])
  @@index([verificationStatus])
}


model Project {
  id          String        @id @default(cuid())
  clientId    String
  title       String
  description String?
  status      ProjectStatus @default(NEW)
  progress    Int           @default(0)
  budget      Decimal?      @db.Decimal(12, 2)
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  client    Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoices  Invoice[]
  contracts Contract[]
  services  ClientService[]
  files     File[]
  notes     ProjectNote[]
  stages    ProjectStage[]
  messages  ProjectMessage[]

  @@index([clientId])
  @@index([status])
}

model ProjectNote {
  id         String         @id @default(cuid())
  projectId  String
  authorId   String
  content    String
  visibility NoteVisibility @default(INTERNAL)
  createdAt  DateTime       @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([projectId])
}

enum ProjectStageStatus {
  PENDING
  IN_PROGRESS
  BLOCKED
  DONE
  SKIPPED
}

model ProjectStage {
  id          String             @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      ProjectStageStatus @default(PENDING)
  progress    Int                @default(0)
  weight      Int                @default(1)
  orderIndex  Int                @default(0)
  dueDate     DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}

model ProjectMessage {
  id           String   @id @default(cuid())
  projectId    String
  authorId     String
  content      String
  attachments  Json?
  isInternal   Boolean  @default(false)
  readByClient Boolean  @default(false)
  readByStaff  Boolean  @default(false)
  createdAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([projectId])
  @@index([createdAt])
}

model ClientService {
  id          String        @id @default(cuid())
  clientId    String
  projectId   String?
  name        String
  type        ServiceType   @default(OTHER)
  status      ServiceStatus @default(ACTIVE)
  price       Decimal?      @db.Decimal(12, 2)
  currency    String        @default("SAR")
  renewalDate DateTime?
  startedAt   DateTime      @default(now())
  endedAt     DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id])

  @@index([clientId])
  @@index([status])
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  clientId      String
  projectId     String?
  status        InvoiceStatus @default(DRAFT)
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  taxRate       Decimal       @default(15) @db.Decimal(5, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  currency      String        @default("SAR")
  issuedAt      DateTime      @default(now())
  dueAt         DateTime?
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  client   Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project  Project?      @relation(fields: [projectId], references: [id])
  items    InvoiceItem[]
  payments Payment[]

  @@index([clientId])
  @@index([status])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  title       String
  description String?
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Contract {
  id             String         @id @default(cuid())
  contractNumber String         @unique
  clientId       String
  projectId      String?
  title          String
  status         ContractStatus @default(DRAFT)
  value          Decimal?       @db.Decimal(12, 2)
  currency       String         @default("SAR")
  startDate      DateTime?
  endDate        DateTime?
  filePath       String?
  signedFilePath String?
  signedAt       DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id])
  files   File[]

  @@index([clientId])
  @@index([status])
}

model SupportTicket {
  id           String         @id @default(cuid())
  ticketNumber String         @unique
  clientId     String
  subject      String
  description  String?
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(NORMAL)
  assignedToId String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  closedAt     DateTime?

  client   Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agent    User?           @relation("AssignedAgent", fields: [assignedToId], references: [id])
  messages TicketMessage[]
  files    File[]

  @@index([clientId])
  @@index([status])
  @@index([priority])
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  senderId   String
  message    String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id])

  @@index([ticketId])
}

model Payment {
  id             String        @id @default(cuid())
  clientId       String
  invoiceId      String?
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("SAR")
  method         PaymentMethod @default(BANK_TRANSFER)
  transactionRef String?
  status         PaymentStatus @default(PENDING)
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime      @default(now())

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([clientId])
  @@index([status])
}

model File {
  id           String   @id @default(cuid())
  clientId     String?
  projectId    String?
  ticketId     String?
  contractId   String?
  uploadedById String
  originalName String
  storedName   String
  path         String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())

  client   Client?        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project  Project?       @relation(fields: [projectId], references: [id])
  ticket   SupportTicket? @relation(fields: [ticketId], references: [id])
  contract Contract?      @relation(fields: [contractId], references: [id])
  uploader User           @relation("UploadedBy", fields: [uploadedById], references: [id])

  @@index([clientId])
  @@index([projectId])
  @@index([ticketId])
  @@index([contractId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  body      String?
  link      String?
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model ProjectRequest {
  id           String                 @id @default(cuid())
  clientId     String
  title        String
  description  String?
  category     ServiceType            @default(OTHER)
  priority     ProjectRequestPriority @default(NORMAL)
  budgetMin    Decimal?               @db.Decimal(12, 2)
  budgetMax    Decimal?               @db.Decimal(12, 2)
  targetDate   DateTime?
  attachments  Json?
  contactName  String?
  contactPhone String?
  status       ProjectRequestStatus   @default(PENDING)
  adminNote    String?
  projectId    String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}
