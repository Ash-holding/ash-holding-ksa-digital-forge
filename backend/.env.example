DATABASE_URL="postgresql://ash:ashpass@localhost:5432/ash_holding?schema=public"

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=https://ash-holding.sa,https://www.ash-holding.sa,http://localhost:8080,http://localhost:5173

# JWT
JWT_SECRET=replace-with-strong-random-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-another-strong-random-secret
JWT_REFRESH_TTL_DAYS=30
COOKIE_SECRET=replace-with-cookie-signing-secret

# Uploads
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=25
UPLOAD_ALLOWED_MIME=image/png,image/jpeg,image/webp,application/pdf,application/zip,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# Rate limits (requests per window)
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_MS=60000

# Seed credentials (development only – change in production)
SEED_ADMIN_EMAIL=admin@ashholding.sa
SEED_ADMIN_PASSWORD=Admin@12345
SEED_SUPPORT_PASSWORD=Support@12345
SEED_ACCOUNTANT_PASSWORD=Account@12345
SEED_CLIENT_EMAIL=client@demo.sa
SEED_CLIENT_PASSWORD=Client@12345

# WhatsApp (SmartWats — https://docs.smartwats.com/)
SMARTWATS_BASE_URL=https://app.smartwats.com/api
SMARTWATS_INSTANCE_ID=
SMARTWATS_ACCESS_TOKEN=
WHATSAPP_DEFAULT_CC=966
PUBLIC_APP_URL=https://ashholding.sa
