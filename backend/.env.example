# ============================
# ASH HOLDING backend .env
# ============================

# Server
NODE_ENV=production
PORT=4000
CORS_ORIGIN=https://ashholding.sa

# Database (PostgreSQL, self-hosted)
DATABASE_URL=postgresql://ash:changeme@postgres:5432/ash_holding?schema=public

# Auth
JWT_SECRET=change-this-to-a-64-char-random-string
JWT_EXPIRES_IN=7d
COOKIE_SECRET=change-this-cookie-secret

# Redis (optional — sessions, queues)
REDIS_URL=redis://redis:6379

# File uploads
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=25

# SMTP (optional — notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ASH HOLDING <no-reply@ashholding.sa>"

# Bootstrap admin (used only by seed)
SEED_ADMIN_EMAIL=admin@ashholding.sa
SEED_ADMIN_PASSWORD=ChangeMe!2026
SEED_CLIENT_EMAIL=client@example.com
SEED_CLIENT_PASSWORD=ChangeMe!2026
